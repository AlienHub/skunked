{
  "extends": "plasmo/templates/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    ".plasmo/index.d.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    ".plasmo"
  ]
}
