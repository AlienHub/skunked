# SKUNKED extension — copy to `.env` and adjust for private deployment.
# Plasmo inlines PLASMO_PUBLIC_* at build time.

# Default public cloud API (override for enterprise private endpoint)
PLASMO_PUBLIC_CLOUD_API_BASE_URL=https://skunked-cloud-api.zhouxiansheng1958.workers.dev

# Independent public open-data API (shared by extension, site, and SaaS tools)
PLASMO_PUBLIC_OPEN_DATA_API_BASE_URL=https://skunked-open-data.pindo.page

# Optional tuning (defaults shown)
# PLASMO_PUBLIC_CLOUD_ANALYZE_TIMEOUT_MS=1800
# PLASMO_PUBLIC_CLOUD_POLICY_SYNC_INTERVAL_MINUTES=30
# PLASMO_PUBLIC_OPEN_DATASET_SYNC_INTERVAL_MINUTES=360
# PLASMO_PUBLIC_CLOUD_REPORT_UPLOAD_INTERVAL_MINUTES=2
# PLASMO_PUBLIC_CLOUD_REPORT_BATCH_SIZE=20
# PLASMO_PUBLIC_WARNING_THRESHOLD=60
# PLASMO_PUBLIC_BLOCK_THRESHOLD=90
# PLASMO_PUBLIC_CACHE_EXPIRY_MS=86400000
# PLASMO_PUBLIC_REPORT_MAX_RETRIES=5
# PLASMO_PUBLIC_LOG_LEVEL=warn
