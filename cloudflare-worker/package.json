{
  "name": "skunked-cloud-api",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "SKUNKED enterprise cloud API on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm exec eslint --config ../eslint.config.mjs \"src/**/*.ts\"",
    "test": "node -e \"process.exit(0)\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,toml}\"",
    "dataset:import": "node ./scripts/import-open-data.mjs skunked-events --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260301.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.8.0"
  }
}
