{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SKUNKED Open Data Official Apps",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "slug",
      "name",
      "nameEn",
      "category",
      "officialDomains",
      "officialUrls",
      "keywords"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$",
        "minLength": 2,
        "maxLength": 64
      },
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$",
        "minLength": 2,
        "maxLength": 64
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "nameEn": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "category": {
        "type": "string",
        "enum": ["office", "communication", "remote_control", "security"]
      },
      "officialDomains": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^(?!www\\.)[a-z0-9-]+(\\.[a-z0-9-]+)+$"
        }
      },
      "officialUrls": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^https://"
        }
      },
      "keywords": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    }
  }
}
